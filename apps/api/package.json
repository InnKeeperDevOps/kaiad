    "@sm/web": "workspace:*",
    "@sm/worker": "workspace:*",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.1.0",
    "ws": "^8.23.0"
